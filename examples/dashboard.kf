// dashboard.kf — stat cards, charts, tabela e navegação num app só
//
//   scripts/run-example.sh dashboard

main() {
    var w = App("Dashboard")

    var nav = Navbar(listOf("visão", "vendas", "estoque"))
    var crumb = Breadcrumbs(listOf("kof", "dashboard", "agosto"))

    var downloads = StatCard("downloads", "12.4k", "+8%")
    var receita = StatCard("receita", "R$ 84k", "+2%")
    var churn = StatCard("churn", "1.9%", "-0.3%")

    var semana = listOf(12, 18, 9, 22, 30, 26, 41)
    var dias = listOf("d", "s", "t", "q", "q", "s", "s")

    var bars = BarsChart(dias, semana, 5)
    var trend = Text(sparkline(semana))
    var trendCap = Muted("últimos 7 dias")
    var trendRow = Row(listOf(trend, trendCap))
    var chartCol = Column(listOf(
        Subheading("downloads por dia"),
        bars,
        VSpace(8),
        trendRow
    ))

    var metaGauge = Gauge(68, 100)
    var metaDonut = Donut(72)

    var tabela = DataTable(
        "produto;status;meta",
        listOf("widgets;andamento;80%", "docs;feito;100%", "site;atrasado;45%")
    )

    var cardsRow = Row(listOf(downloads.root(), receita.root(), churn.root()))
    var metaRow = Row(listOf(metaGauge, metaDonut))
    var progresso = Text(progressBar(29, 41))
    w.bind(Column(listOf(
        nav.root(),
        crumb,
        cardsRow,
        chartCol,
        metaRow,
        tabela,
        progresso
    )))
    w.show()
}
