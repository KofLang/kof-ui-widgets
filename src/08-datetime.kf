// 08-datetime.kf — calendário, date picker e time picker.
//
// O calendário civil vem de `kof.time` (time.dayOfWeek/isLeapYear/
// daysInMonth/isWeekend) — a plataforma cuida da aritmética; a biblioteca
// só converte para 0=domingo e desenha a grade. As funções continuam puras
// e testáveis por valor exato (as âncoras históricas do teste continuam
// valendo, porque a plataforma tem paridade byte-a-byte nos alvos).
//
// Relógio ao vivo: deixou de ser gap de plataforma (UIW020 fechado 15/09 —
// datas ISO na stdlib, aritmética de Long no `time.now()` roda nos 3 alvos,
// timer do UIW008 disponível). Entrou: `clockTime`/`spinnerFrame` (puras,
// travadas em âncoras absolutas) + `Clock`/`Spinner` (vivos; o Spinner para
// sozinho via handle-sombra). setText é no-op em JVM/Native — a prova é a
// transição pura nos 3 alvos.

record PickerParts(View root)

// ---- relógio + spinner (UIW008/UIW020 fechados) ---------------------------------------
//
// Transições puras primeiro (regra da casa): clockTime/spinnerFrame não
// tocam em relógio nem handle — são provadas por valor exato em âncoras
// históricas. Os widgets vivos só colam a transição ao timer.

// zero-pad de 2 digitos — padStart da casa preenche com ESPACO, o que
// quebraria o relogio (e ja quebrava o timeLabel, que a doc prometia
// "09:15 zero-empilhado").
pad2(Int v): String {
    if (v < 10) {
        return "0" + str(v)
    }
    return str(v)
}

// epoch millis (UTC) -> "HH:MM:SS". Aritmética em Long; os campos ficam
// < 60/24, então o cast Long->Int é exato (nada estoura o Int).
clockTime(Long millis): String {
    var secs = millis / 1000
    var s = (secs % 60) as Int
    var m = ((secs / 60) % 60) as Int
    var h = ((secs / 3600) % 24) as Int
    return pad2(h) + ":" + pad2(m) + ":" + pad2(s)
}

// quadro do spinner a partir de um passo (wrap em 8; o passo vem de um
// contador interno, nunca negativo — `%` de inteiro simples basta).
spinnerFrame(Int step): String {
    var frames = listOf("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧")
    return frames.get(step % 8)
}

// ---- calendário civil (kof.time) ----------------------------------------------------
//
// A plataforma já traz o calendário (S7-wedge, paridade JVM/JS/Native):
// `time.dayOfWeek` (ISO, 1=segunda .. 7=domingo), `time.isLeapYear`,
// `time.daysInMonth` e `time.isWeekend`. A biblioteca não reimplementa a
// plataforma (R2) — só converte para o contrato da casa (0=domingo).

// dia da semana (0=domingo .. 6=sábado).
dayOfWeek(Int year, Int month, Int day): Int {
    return time.dayOfWeek(year, month, day) % 7
}

isLeapYear(Int year): Bool {
    return time.isLeapYear(year)
}

daysInMonth(Int year, Int month): Int {
    return time.daysInMonth(year, month)
}

// sábado ou domingo — o `isWeekend` da plataforma.
isWeekend(Int year, Int month, Int day): Bool {
    return time.isWeekend(year, month, day)
}

// ---- Calendar -------------------------------------------------------------------------

Calendar(Int year, Int month): Label {
    var l = Label(monthGrid(year, month))
    var h = l
    return h
}

// grade pura: cabeçalho D S T Q Q S S + semanas, domingo primeiro.
monthGrid(Int year, Int month): String {
    var out = monthName(month) + " " + year + "\n"
    out = out + "D  S  T  Q  Q  S  S\n"

    var first = dayOfWeek(year, month, 1)
    var total = daysInMonth(year, month)

    var cell = 0
    while (cell < first) {
        out = out + "   "
        cell = cell + 1
    }

    var d = 1
    while (d <= total) {
        var label = padStart(str(d), 2)
        out = out + label
        out = out + calendarSuffix(cell, d, total)
        cell = cell + 1
        d = d + 1
    }
    return out
}

calendarSuffix(Int cell, Int day, Int total): String {
    if (cell % 7 == 6 || day == total) { return "\n" }
    return " "
}

monthName(Int month): String {
    if (month == 1) { return "jan" }
    if (month == 2) { return "fev" }
    if (month == 3) { return "mar" }
    if (month == 4) { return "abr" }
    if (month == 5) { return "mai" }
    if (month == 6) { return "jun" }
    if (month == 7) { return "jul" }
    if (month == 8) { return "ago" }
    if (month == 9) { return "set" }
    if (month == 10) { return "out" }
    if (month == 11) { return "nov" }
    return "dez"
}

// ---- DatePicker ---------------------------------------------------------------------------

class DateState {
    static Int year = 2026
    static Int month = 8
    static Int day = 24
}

// transições puras de mês (testáveis).
prevMonth(Int m): Int {
    if (m == 1) {
        return 12
    }
    return m - 1
}

nextMonth(Int m): Int {
    if (m == 12) {
        return 1
    }
    return m + 1
}

DatePicker(): PickerParts {
    var theme = CurrentTheme()
    var view = Label(monthGrid(DateState.year, DateState.month))

    var prevM = Button("‹", () -> {
        DateState.month = prevMonth(DateState.month)
        if (DateState.month == 12) {
            DateState.year = DateState.year - 1
        }
        view.setText(monthGrid(DateState.year, DateState.month))
    })
    var nextM = Button("›", () -> {
        DateState.month = nextMonth(DateState.month)
        if (DateState.month == 1) {
            DateState.year = DateState.year + 1
        }
        view.setText(monthGrid(DateState.year, DateState.month))
    })

    var pmh = prevM
    var nmh = nextM
    var strip = Row(listOf(pmh, nmh))
    var col = Column(listOf(strip, view))
    var box = View(Style(theme.surface(), theme.text(), 12, 8))
    box.bind(col)
    var bh = box
    return PickerParts(bh)
}

// ---- TimePicker ------------------------------------------------------------------------------

class TimeState {
    static Int hour = 9
    static Int minute = 0
}

TimePicker(): PickerParts {
    var theme = CurrentTheme()
    var view = Label(timeLabel())

    var upH = Button("+1h", () -> {
        TimeState.hour = wrapNext(TimeState.hour, 24)
        view.setText(timeLabel())
    })
    var upM = Button("+15m", () -> {
        TimeState.minute = wrapNext(TimeState.minute + 14, 60)
        view.setText(timeLabel())
    })

    var uh = upH
    var um = upM
    var actions = Row(listOf(uh, um))
    var col = Column(listOf(view, actions))
    var box = View(Style(theme.surface(), theme.text(), 12, 8))
    box.bind(col)
    var bh = box
    return PickerParts(bh)
}

timeLabel(): String {
    return pad2(TimeState.hour) + ":" + pad2(TimeState.minute)
}

// ---- Clock / Spinner (vivos: timer do UIW008) ----------------------------------------

// Relógio UTC ao vivo: "YYYY-MM-DD HH:MM:SS", atualizado a cada segundo.
// A data vem de `time.todayIso()` (stdlib — R2, nada de inversa civil na
// lib); a hora de `clockTime`. Sem cancel: vive com o app (hangprobe: jobs
// recorrentes sem cancel não impedem o processo de encerrar em nenhum alvo).
// Em JVM/Native o setText é no-op (sem render) — a transição pura é a prova.
Clock(): Label {
    var view = Label(time.todayIso() + " " + clockTime(time.now()))

    time.interval(1000, () -> {
        view.setText(time.todayIso() + " " + clockTime(time.now()))
    })
    var vh = view
    return vh
}

// Spinner de `frames` quadros braille a cada `ms` milissegundos; para
// sozinho (handle-sombra — o job nunca lê a var do próprio interval,
// Kof4j §253). frames <= 0 mostra o primeiro quadro parado.
Spinner(Int frames, Int ms): Label {
    var view = Label(spinnerFrame(0))
    if (frames <= 0) {
        var vh0 = view
        return vh0
    }
    var step = 0
    var myId = ""
    var id = time.interval(ms, () -> {
        if (step < frames) {
            step = step + 1
            view.setText(spinnerFrame(step))
        } else if (myId.length > 0) {
            time.cancel(myId)
        }
    })
    myId = id
    var vh = view
    return vh
}

// ---- Skeleton animado (rodada no roadmap: "pendente de design") ----------------------
//
// Placeholder de carregamento: `rows` barras na largura `width`, com um
// brilho `▓` varrendo cada barra a cada `ms` — a linha i defasada de i
// (onda diagonal). Design fechado reusando só o que a casa já provou:
// transição PURA travada por valor exato (spinneFrame; sem Date, sem
// handle — determinística em qualquer alvo) + o timer do UIW008 no mesmo
// padrão do Clock (interval sem cancel: o job vive com o widget; a
// hangprobe mediu que jobs recorrentes sem cancel NÃO impedem o processo
// de encerrar em nenhum alvo — e evita de propósito o self-cancel do
// §253, que trava no native). Em JVM/Native o setText é no-op (sem
// render) — a prova é a transição pura nos 3 alvos.
//
// O job do interval roda um `while` sobre as barras — forma que já foi
// a armadilha do §266 (loop com corpo grande no reconstructor JS); agora
// verte com o marcador estrutural, e este widget é prova de vida a mais.

// barra da skeleton no passo `step` e largura `width`: `▓` na posição
// step % width, `░` no resto. width <= 0 => "" (linha invisível).
skeletonShimmer(Int step, Int width): String {
    if (width <= 0) {
        return ""
    }
    var pos = step % width
    return repeat("░", pos) + "▓" + repeat("░", width - pos - 1)
}

record SkeletonParts(View root, List<Label> bars)

// Skeleton viva: `rows` barras de largura `width`, varredura a cada `ms`.
// rows <= 0 => caixa vazia; ms <= 0 => brilho parado na fase de construção
// (linha i mostra skeletonShimmer(i, width)).
Skeleton(Int rows, Int width, Int ms): SkeletonParts {
    var bars = new List<Label>()
    var i = 0
    while (i < rows) {
        bars.add(Label(skeletonShimmer(i, width)))
        i = i + 1
    }
    var box = View(Style(SurfaceColor(), MutedColor(), 12, 8))
    box.bind(Column(bars))
    var step = 0
    if (rows > 0 && ms > 0) {
        time.interval(ms, () -> {
            step = step + 1
            var p = 0
            while (p < bars.size) {
                bars.get(p).setText(skeletonShimmer(step + p, width))
                p = p + 1
            }
        })
    }
    var parts = SkeletonParts(box, bars)
    return parts
}
