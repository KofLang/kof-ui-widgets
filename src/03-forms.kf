// 03-forms.kf — campos de formulário e validação.
//
// Eventos são reais no alvo JS: `.on("input", (e: Event) -> ...)` entrega o
// valor digitado (UI006) — o TextField já sincroniza ao vivo. O botão ↻
// continua como leitura explícita, para quem prefere o clique.
//
// Multi-instância: cada TextField criado compartilha TextFieldState
// (limite alpha documentado). Para campos independentes, crie os Inputs
// direto e leia com input.text() — docs/learn/04-forms.md mostra a receita.
//
// Validação: os predicados genéricos vêm de `kof.validation`; a biblioteca
// só compõe o resumo para o formulário.

class TextFieldState {
    static String value = ""
}

record TextFieldParts(View root, Button refresh, Input input)

TextField(String caption, String placeholder): TextFieldParts {
    var inp = Input("")
    inp.setPlaceholder(placeholder)
    var hint = Muted("")
    inp.on("input", (e: Event) -> {
        TextFieldState.value = e.value()
        hint.setText("" + e.value().length + " caracteres")
    })
    var refresh = Button("↻ salvar valor", () -> {
        TextFieldState.value = inp.text()
        hint.setText("valor salvo")
    })
    var box = View(Style(SurfaceColor(), TextColor(), 12, 8))
    box.bind(Column(listOf(Muted(caption), inp, hint, refresh)))
    return TextFieldParts(box, refresh, inp)
}

// ---- Validação (pura — testável em todos os alvos) ---------------------------
//
// kof.validation cobre os predicados genéricos (minLength/maxLength/isEmail/
// isUrl/matches/isInt/...). A biblioteca reexporta os que o formulário usa,
// para o app não precisar importar dois namespaces.

isBlank(String s): Bool {
    return s == ""
}

minLength(String s, Int n): Bool {
    return validation.minLength(s, n)
}

maxLength(String s, Int n): Bool {
    return validation.maxLength(s, n)
}

isEmail(String s): Bool {
    return validation.isEmail(s)
}

isNumber(String s): Bool {
    if (s.length == 0) {
        return false
    }
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c < '0' || c > '9') {
            return false
        }
        i = i + 1
    }
    return true
}

// posição da agulha (contrato da casa: agulha vazia é ausente).
indexOf(String s, String needle): Int {
    if (needle.length == 0) {
        return -1
    }
    return s.indexOf(needle)
}

// resumo de validação: lista de erros -> texto para o label do formulário.
validationSummary(List<String> errors): String {
    if (errors.size == 0) {
        return "✓ tudo certo"
    }
    var out = "✕ corrija " + errors.size + " campo(s):"
    var i = 0
    while (i < errors.size) {
        out = out + "\n• " + errors.get(i)
        i = i + 1
    }
    return out
}
