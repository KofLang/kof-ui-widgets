// 01-typography.kf — texto nos três níveis + variações.
//
// Link clicável é primitivo da plataforma desde o update:
//   Link("documentação", "https://kof.dev")   // texto + url
//
// Padrão do Kof: cada intenção é um construtor que devolve o handle pronto.

Heading(String text): Label {
    var l = Label(text)
    l.setFont(Font("DejaVu Sans", 14))
    l.setColor(TextColor())
    l.fontSize = 26
    l.bold = true
    var h = l
    return h
}

Subheading(String text): Label {
    var l = Label(text)
    l.setFont(Font("DejaVu Sans", 14))
    l.setColor(TextColor())
    l.fontSize = 18
    l.bold = true
    var h = l
    return h
}

Text(String text): Label {
    var l = Label(text)
    l.setFont(Font("DejaVu Sans", 14))
    l.setColor(TextColor())
    var h = l
    return h
}

Muted(String text): Label {
    var l = Label(text)
    l.setFont(Font("DejaVu Sans", 14))
    l.setColor(TextColor())
    l.fontSize = 13
    l.color = MutedColor()
    var h = l
    return h
}

Code(String text): Label {
    var l = Label(text)
    l.setFont(Font("DejaVu Sans", 14))
    l.setColor(TextColor())
    l.color = Palette.cyan
    var f = Font("DejaVu Sans Mono", 13)
    l.setFont(f)
    var h = l
    return h
}

Quote(String text): View {
    var theme = CurrentTheme()
    var bar = View(Style(theme.primary(), Palette.transparent, 2, 2))
    var l = Label(text)
    l.setFont(Font("DejaVu Sans", 14))
    l.setColor(TextColor())
    l.color = MutedColor()
    bar.bind(l)
    var h = bar
    return h
}
