// 08-datetime — calendário kof.time contra âncoras conhecidas + grade exata.

test "dayOfWeek âncoras históricas" {
    assert(dayOfWeek(1970, 1, 1) == 4, "epoch: quinta")
    assert(dayOfWeek(2000, 1, 1) == 6, "ano 2000: sábado")
    assert(dayOfWeek(2024, 2, 29) == 4, "bissexto 2024: quinta")
    assert(dayOfWeek(2026, 8, 1) == 6, "1/ago/2026: sábado")
    assert(dayOfWeek(2026, 8, 24) == 1, "24/ago/2026: segunda")
}

test "daysInMonth" {
    assert(daysInMonth(2026, 2) == 28, "fev comum")
    assert(daysInMonth(2024, 2) == 29, "fev bissexto")
    assert(daysInMonth(2026, 8) == 31, "agosto")
    assert(daysInMonth(2026, 4) == 30, "abril")
}

test "isLeapYear" {
    assert(isLeapYear(2024), "divisível por 4")
    assert(isLeapYear(1900) == false, "centena não-bissexta")
    assert(isLeapYear(2000), "quatrocentos é bissexto")
    assert(isLeapYear(2026) == false, "ano comum")
}

test "isWeekend marca sábado e domingo" {
    assert(isWeekend(2026, 8, 1), "1/ago/2026 é sábado")
    assert(isWeekend(2026, 8, 2), "2/ago/2026 é domingo")
    assert(isWeekend(2026, 8, 3) == false, "3/ago/2026 é segunda")
    assert(isWeekend(2026, 8, 7) == false, "7/ago/2026 é sexta")
}

test "mês anterior e próximo" {
    assert(prevMonth(8) == 7, "agosto -> julho")
    assert(prevMonth(1) == 12, "janeiro -> dezembro")
    assert(nextMonth(8) == 9, "agosto -> setembro")
    assert(nextMonth(12) == 1, "dezembro -> janeiro")
}

test "monthGrid de agosto/2026 é exata" {
    var expected = "ago 2026\n"
    expected = expected + "D  S  T  Q  Q  S  S\n"
    expected = expected + "                   1\n"
    expected = expected + " 2  3  4  5  6  7  8\n"
    expected = expected + " 9 10 11 12 13 14 15\n"
    expected = expected + "16 17 18 19 20 21 22\n"
    expected = expected + "23 24 25 26 27 28 29\n"
    expected = expected + "30 31\n"
    assert(monthGrid(2026, 8) == expected, "grade de agosto/2026")
}

test "pickers constroem" {
    var w = Window("datas")
    var cal = Calendar(2026, 8)
    var dp = DatePicker()
    var tp = TimePicker()
    w.bind(cal)
    w.bind(dp.root())
    w.bind(tp.root())
}

test "clockTime âncoras absolutas (UTC)" {
    assert(clockTime(0) == "00:00:00", "epoch")
    assert(clockTime(3661000) == "01:01:01", "1h1m1s")
    assert(clockTime(1757900000000) == "01:33:20", "âncora 2025-09-15")
    assert(clockTime(86399000) == "23:59:59", "fim do dia")
}

test "spinnerFrame wrap" {
    assert(spinnerFrame(0) == "⠋", "primeiro")
    assert(spinnerFrame(1) == "⠙", "segundo")
    assert(spinnerFrame(8) == "⠋", "wrap")
    assert(spinnerFrame(9) == "⠙", "wrap+1")
}

test "Clock e Spinner constroem (no-op em JVM/Native)" {
    var c = Clock()
    var s = Spinner(8, 10)
    time.sleep(40)
    // JS renderiza (ISO+hora = 19; braille = 1 char); JVM/Native = "" no-op.
    assert(c.text().length == 0 || c.text().length == 19, "relogio: " + c.text())
    assert(s.text().length == 0 || s.text().length == 1, "quadro: " + s.text())
}

test "skeletonShimmer valores exatos (transição pura)" {
    assert(skeletonShimmer(0, 4) == "▓░░░", "fase 0")
    assert(skeletonShimmer(1, 4) == "░▓░░", "fase 1")
    assert(skeletonShimmer(3, 4) == "░░░▓", "fase 3 = ultima pos")
    assert(skeletonShimmer(4, 4) == "▓░░░", "wrap: 4%4=0")
    assert(skeletonShimmer(7, 4) == "░░░▓", "wrap: 7%4=3")
    assert(skeletonShimmer(0, 1) == "▓", "largura 1")
    assert(skeletonShimmer(5, 0) == "", "largura 0 invisivel")
    assert(skeletonShimmer(0, -2) == "", "largura negativa")
}

test "skeletonShimmer largura impar + varredura completa" {
    assert(skeletonShimmer(0, 5) == "▓░░░░", "5 wide fase 0")
    assert(skeletonShimmer(2, 5) == "░░▓░░", "5 wide meio")
    assert(skeletonShimmer(4, 5) == "░░░░▓", "5 wide fim")
    assert(skeletonShimmer(5, 5) == "▓░░░░", "5 wide wrap")
}

test "Skeleton constrói + barra viva no JS (no-op em JVM/Native)" {
    var s = Skeleton(3, 6, 10)
    time.sleep(40)
    // construída = 3 barras de largura 6, cada uma exatamente 6 chars no JS
    // (no-op em JVM/Native: text() vazio).
    assert(s.bars.size == 3, "3 barras: " + s.bars.size)
    var b0 = s.bars.get(0).text()
    var b1 = s.bars.get(1).text()
    assert(b0 == "" || b0.length == 6, "barra 0: '" + b0 + "' (len " + b0.length + ")")
    // onda diagonal ao DOM: em JS as 3 barras têm FASE deslocada (width 6 >
    // rows 3), então lidas no mesmo instante são strings DISTINTAS. Prova que
    // o offset por linha (step + p) chegou no render, não só a construção.
    if (b0.length == 6) {
        assert(b0 != b1, "fases deslocadas: b0='" + b0 + "' b1='" + b1 + "'")
    }
}

main() {
}
