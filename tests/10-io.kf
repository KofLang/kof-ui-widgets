// 10-io — preview de arquivo: texto exato (função pura).

test "filePreview mostra até 5 linhas" {
    var three = split("l1\nl2\nl3", "\n")
    assert(three.size == 3, "split por \\n funciona")

    var small = filePreview("linha um\nlinha dois")
    assert(small.startsWith("│ linha um\n"), "primeira linha prefixada")
    assert(small.contains("│ linha dois"), "segunda linha presente")
    assert(!small.contains("+"), "sem rodapé quando cabe")
}

test "filePreview trunca com rodapé" {
    var big = filePreview("a\nb\nc\nd\ne\nf\ng")
    assert(big.startsWith("│ a\n"), "começa na primeira")
    assert(big.endsWith("+2 linhas"), "rodapé conta o resto")
}

test "filePreview vazio" {
    assert(filePreview("") == "(arquivo vazio)", "vazio reportado")
}

test "FilePicker constrói" {
    var w = Window("arquivos")
    var fp = FilePicker("abrir log")
    w.bind(fp.root())
}

// UIW031 (16/09): kof.io no alvo JS. O round-trip write→exists→size→read
// roda byte-parity nos 3 alvos (o JS delega ao host GraalJS). Caminho
// absoluto fixo: writeText sobrescreve, então o estado pós-write é
// determinístico independentemente de corrida entre alvos.
test "kof.io round-trip existe nos 3 alvos" {
    var p = Path("/tmp/kof-uiw031-pick.txt")
    p.writeText("dados")
    assert(p.exists() == true, "exists após write")
    assert(p.size() == 5, "size conta os bytes")
    assert(p.readText() == "dados", "read devolve o que foi escrito")
}

main() {
}
