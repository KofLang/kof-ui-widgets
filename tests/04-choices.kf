// 04-choices — transições puras + construção por instância.

test "flip alterna" {
    assert(flip(true) == false, "true vira false")
    assert(flip(false) == true, "false vira true")
    assert(flip(flip(true)) == true, "duas voltas")
}

test "ratingFace desenha estrelas" {
    assert(ratingFace(0) == "☆☆☆", "zero")
    assert(ratingFace(1) == "★☆☆", "uma")
    assert(ratingFace(2) == "★★☆", "duas")
    assert(ratingFace(3) == "★★★", "três")
    assert(ratingFace(9) == "★★★", "teto em três")
}

test "toggleStars: mesma nota zera" {
    assert(toggleStars(0, 1) == 1, "sobe para 1")
    assert(toggleStars(1, 1) == 0, "mesma estrela zera")
    assert(toggleStars(1, 3) == 3, "troca direta")
    assert(toggleStars(3, 3) == 0, "teto zerável")
}

test "radioSelected começa sem seleção" {
    assert(radioSelected() == -1, "espelho inicial é -1")
}

test "cada instância constrói independente" {
    var w = Window("choices")
    Int c1 = Checkbox("primeira").root()
    Int c2 = Checkbox("segunda").root()
    Int sw = ToggleSwitch("som").root()
    Int r1 = RadioGroup(listOf("pequeno")).root()
    Int r4 = RadioGroup(listOf("a", "b", "c", "d")).root()
    Int rt = Rating("kof").root()
    w.bind(c1)
    w.bind(c2)
    w.bind(sw)
    w.bind(r1)
    w.bind(r4)
    w.bind(rt)
}

main() {
}
