test "moeda em centavos" {
    assert(formatMoney(123456, "R$") == "R$ 1.234,56", "agrupa milhares")
    assert(formatMoney(-9, "R$") == "-R$ 0,09", "negativo menor que um real")
    assert(formatMoney(0, "€") == "€ 0,00", "zero")
}

test "percentuais limitados e sem divisão por zero" {
    assert(formatPercent(3, 4) == "75%", "proporção")
    assert(formatPercent(3, 0) == "—", "sem total")
    assert(formatPercent(-5, 10) == "0%", "limite inferior")
    assert(formatPercent(20, 10) == "100%", "limite superior")
}

test "datas e preenchimento" {
    assert(formatDate(2024, 2, 29) == "29/02/2024", "bissexto")
    assert(zeroPad(7, 3) == "007", "preenchimento")
    assert(zeroPad(2026, 2) == "2026", "não trunca")
}

test "data inválida é rejeitada" {
    var rejected = false
    try { formatDate(2026, 2, 29) } catch (String error) { rejected = true }
    assert(rejected, "29 de fevereiro em ano comum")
}

test "split rejeita separador vazio" {
    var rejected = false
    try { split("abc", "") } catch (String error) { rejected = true }
    assert(rejected, "não pode entrar em loop infinito")
}

test "elevação cresce por nível e clampa" {
    assert(shadowOffset(0) == 0 && shadowBlur(0) == 0 && shadowAlpha(0) == 0, "nível 0 é plana")
    assert(shadowOffset(2) == 4, "offset do nível 2")
    assert(shadowBlur(2) == 12, "blur do nível 2")
    assert(shadowAlpha(2) == 40, "opacidade do nível 2")
    assert(shadowOffset(9) == shadowOffset(4), "clampa no topo")
    assert(shadowBlur(-3) == 0, "clampa no piso")
    assert(ShadowColor(0).alpha() == 0, "cor plana é transparente")
    assert(ShadowColor(4).alpha() == 80, "cor elevada tem opacidade")
}

test "superfícies com elevação constroem" {
    var w = Window("design")
    w.bind(Hero("Kof", "menos cerimônia"))
    w.bind(Content(640, Card("cartão") as Int))
    w.bind(Fill(Text("ocupa o resto") as Int))
}

main() { }
