// 06-overlays — glifos/cores puros + fumaça de janelas (JVM no-op).

test "alertGlyph por tipo" {
    assert(alertGlyph("ok") == "✓", "ok")
    assert(alertGlyph("info") == "i", "info")
    assert(alertGlyph("warn") == "!", "warn")
    assert(alertGlyph("error") == "✕", "error")
    assert(alertGlyph("qualquer") == "✓", "default é ok")
}

test "alertColor segue a semântica" {
    assert(alertColor("error") == ErrorColor(), "erro usa cor de erro")
    assert(alertColor("warn") == Palette.yellow, "warn amarelo")
    assert(alertColor("info") == Palette.cyan, "info ciano")
    assert(alertColor("ok") == Palette.green, "ok verde")
}

test "estado inicial do confirm" {
    assert(confirmAnswered() == false, "não respondido")
}

test "overlays constroem (janelas no-op em JVM)" {
    // chamar já é o teste: construir não pode lançar
    MessageDialog("título", "mensagem")
    Confirm("excluir?", "tem certeza?")
    Drawer("menu", Muted("conteúdo lateral") as Int)
    Tooltip("kof", "linguagem orientada à intenção")
    Toast("salvo com sucesso")
}

test "one-shot cancela sozinho via handle-sombra" {
    // Padrão do §253: o job lê myId (Str capturada comum), nunca a var do
    // proprio time.interval — cancel-by-id real nos 3 alvos.
    var fired = 0
    var myId = ""
    var id = time.interval(10, () -> {
        if (fired == 0 && myId.length > 0) {
            fired = 1
            time.cancel(myId)
        }
    })
    myId = id
    time.sleep(90)
    var before = fired
    time.sleep(90)
    assert(before >= 1, "disparou: " + str(before))
    assert(fired == before, "se cancelou: " + str(fired))
}

test "ToastAutoDismiss constrói (janela no-op em JVM/Native)" {
    var w = ToastAutoDismiss("salvo", 30)
    assert(true, "construiu sem lançar")
}

main() {
}
